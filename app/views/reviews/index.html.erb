<% if params[:book_id] %>
  <% if @book.present? %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-5">
      <div>
        <h1 class="page-title"><%= @book.title %></h1>
        <p class="page-sub">
          <%= pluralize(@reviews.total_count, "review") %>
        </p>
      </div>
      <%= link_to "Back to Book", book_path(@book), class: "btn reviews-btn-outline btn-sm mt-1" %>
    </div>

    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <div class="review-item">

          <div class="review-header">
            <div class="d-flex align-items-center gap-2">
              <div class="review-avatar">
                <%= review.user.name.first.upcase %>
              </div>
              <div>
                <span class="review-username">
                  <%= link_to review.user.name, user_path(review.user), class: "text-decoration-none" %>
                </span>
                <% if review.user.admin? %>
                  <span class="admin-badge ms-1">Admin</span>
                <% end %>
                <div class="review-date"><%= review.created_at.strftime('%b %d, %Y') %></div>
              </div>
            </div>
            <div class="review-stars">
              <%= '★' * review.rating.to_i %><%= '☆' * (5 - review.rating.to_i) %>
            </div>
          </div>

          <p class="review-content"><%= review.content %></p>

          <% if policy(review).destroy? %>
            <div class="review-actions">
              <%= button_to "Delete",
                            review_path(review),
                            method: :delete,
                            data: { turbo_confirm: "Are you sure?" },
                            class: "btn btn-outline-danger btn-sm",
                            form_class: "d-inline" %>
            </div>
          <% end %>

        </div>
      <% end %>

      <div class="text-center mt-5">
        <%= paginate @reviews %>
      </div>

    <% else %>
      <div class="empty-state">
        <div class="empty-icon">💬</div>
        <h3 class="empty-title">No reviews yet</h3>
        <p class="empty-sub">Be the first to review this book</p>
        <%= link_to "← Back to Book", book_path(@book), class: "btn reviews-btn-primary btn-sm mt-2" %>
      </div>
    <% end %>

  <% end %>

<% elsif params[:user_id] %>
  <% if @user.present? %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-5">
      <div>
        <h1 class="page-title"><%= @user.name %>'s Reviews</h1>
        <p class="page-sub">
          <%= pluralize(@reviews.total_count, "review") %>
        </p>
      </div>
      <%= link_to "← Back to Profile", user_path(@user), class: "btn reviews-btn-outline btn-sm mt-1" %>
    </div>

    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <div class="review-item">

          <div class="review-header">
            <div>
              <h6 class="review-book-title">
                <%= link_to review.book.title, book_path(review.book), class: "text-decoration-none" %>
              </h6>
              <div class="review-date"><%= review.created_at.strftime('%b %d, %Y') %></div>
            </div>
            <div class="review-stars">
              <%= '★' * review.rating.to_i %><%= '☆' * (5 - review.rating.to_i) %>
            </div>
          </div>

          <p class="review-content"><%= review.content %></p>

          <% if policy(review).destroy? %>
            <div class="review-actions">
              <%= button_to "Delete",
                            review_path(review),
                            method: :delete,
                            data: { turbo_confirm: "Are you sure?" },
                            class: "btn btn-outline-danger btn-sm",
                            form_class: "d-inline" %>
            </div>
          <% end %>

        </div>
      <% end %>

      <div class="text-center mt-5">
        <%= paginate @reviews %>
      </div>

    <% else %>
      <div class="empty-state">
        <div class="empty-icon">💬</div>
        <h3 class="empty-title">No reviews yet</h3>
        <p class="empty-sub"><%= @user.name %> hasn't reviewed any books yet</p>
        <%= link_to "← Back to Profile", user_path(@user), class: "btn reviews-btn-primary btn-sm mt-2" %>
      </div>
    <% end %>

  <% end %>
<% end %>

<style>

/* ===== PAGE HEADER ===== */
.page-title {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.2rem;
}

.page-sub {
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin: 0;
}

/* ===== BUTTONS ===== */
.reviews-btn-outline {
  border: 1px solid var(--border);
  color: var(--text-main);
  background: transparent;
  border-radius: 8px;
}

.reviews-btn-outline:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

.reviews-btn-primary {
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 8px;
}

.reviews-btn-primary:hover {
  background: var(--primary-hover);
  color: white;
}

/* ===== REVIEW ITEM ===== */
.review-item {
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--border);
}

.review-item:last-of-type {
  border-bottom: none;
}

/* ===== HEADER ===== */
.review-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
}

/* ===== AVATAR ===== */
.review-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  font-size: 0.85rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== USERNAME ===== */
.review-username {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-main);
}

.review-username a {
  color: var(--text-main);
  transition: color 0.2s;
}

.review-username a:hover {
  color: var(--primary);
}

/* ===== BOOK TITLE (user reviews) ===== */
.review-book-title {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 0.15rem;
}

.review-book-title a {
  color: var(--text-main);
  transition: color 0.2s;
}

.review-book-title a:hover {
  color: var(--primary);
}

/* ===== DATE ===== */
.review-date {
  font-size: 0.75rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

/* ===== STARS ===== */
.review-stars {
  color: #facc15;
  font-size: 0.9rem;
  flex-shrink: 0;
}

/* ===== CONTENT ===== */
.review-content {
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 0.5rem;
}

/* ===== ACTIONS ===== */
.review-actions {
  margin-top: 0.5rem;
}

/* ===== ADMIN BADGE ===== */
.admin-badge {
  font-size: 0.7rem;
  font-weight: 600;
  background: rgba(239,68,68,0.12);
  color: #ef4444;
  border: 1px solid rgba(239,68,68,0.25);
  padding: 1px 7px;
  border-radius: 20px;
}

/* ===== EMPTY STATE ===== */
.empty-state {
  text-align: center;
  padding: 4rem 1rem;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 1rem;
}

.empty-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 0.5rem;
}

.empty-sub {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

</style>