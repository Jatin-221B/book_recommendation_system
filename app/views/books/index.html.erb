<div class="container-fluid py-4">
  
  <!-- Header -->
  <div class="row mb-4">
    <div class="col">
      <h1 class="mb-2">Books</h1>
      <p class="text-muted">Browse our collection</p>
    </div>
  </div>

  <!-- Books Grid -->
  <div class="row g-3">
    <% @books.each do |book| %>
      <div class="col-6 col-sm-4 col-md-3 col-lg-2">
        <%= link_to book_path(book), class: "text-decoration-none" do %>
          <div class="book-card">
            <!-- Cover Image -->
            <div class="book-cover">
              <%= image_tag book.cover_url, 
                           alt: book.title,
                           class: "img-fluid",
                           loading: "lazy" %>
            </div>
            
            <!-- Book Info -->
            <div class="book-info">
              <h6 class="book-title"><%= truncate(book.title, length: 60) %></h6>
              <p class="book-author"><%= truncate(book.author.name, length: 40) %></p>
              <span class="badge bg-primary book-genre"><%= book.genre %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @books.respond_to?(:total_pages) && @books.total_pages > 1 %>
    <div class="row mt-4">
      <div class="col text-center">
        <%= paginate @books %>
      </div>
    </div>
  <% end %>

</div>

<style>
./* Each column stretches to match its neighbours */
.col-6, .col-sm-4, .col-md-3, .col-lg-2 {
  display: flex;
}

.book-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  transition: transform 0.2s ease;
}

.book-cover {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  background: #f0f0f0;
  margin-bottom: 0.75rem;
  aspect-ratio: 2 / 3;   /* bring this back for uniform cover heights */
}

.book-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;         /* fills the box */
  object-position: center top; /* anchors to top edge */
  display: block;
}

.book-info {
  flex: 1;                   /* pushes info to fill remaining card space */
  display: flex;
  flex-direction: column;
  padding: 0 0.25rem;
}

.book-genre {
  margin-top: auto;          /* pins badge to bottom of card */
  align-self: flex-start;
  font-size: 0.7rem;
  padding: 0.25rem 0.5rem;
}
</style>
