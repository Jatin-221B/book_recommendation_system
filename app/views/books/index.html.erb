<div class="container-fluid py-4">
  
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-5">
    <div class="col">
      <h1 class="mb-2">Books</h1>
      <p class="text-muted">Browse our collection</p>
     
    </div>
     <%= link_to "Home", root_path, class: "btn btn-outline-secondary btn-sm custom-btn" %>
  </div>

  <!-- Books Grid -->
  <div class="row g-3">
    <% @books.each do |book| %>
      <div class="col-6 col-sm-4 col-md-3 col-lg-2">
        <%= link_to book_path(book), class: "text-decoration-none" do %>
          <div class="book-card">
            <!-- Cover Image -->
            <div class="book-cover">
              <%= image_tag book.cover_url, 
                           alt: book.title,
                           class: "img-fluid",
                           loading: "lazy" %>
            </div>
            
            <!-- Book Info -->
            <div class="book-info">
              <h6 class="book-title"><%= truncate(book.title, length: 60) %></h6>
              <p class="book-author"><%= truncate(book.author.name, length: 40) %></p>
              <span class="badge bg-primary book-genre"><%= book.genre %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @books.respond_to?(:total_pages) && @books.total_pages > 1 %>
    <div class="row mt-4">
      <div class="col text-center">
        <div class="paginate">
        <%= paginate @books %>
        </div>
      </div>
    </div>
  <% end %>

</div>

<style>

  ./* Each column stretches to match its neighbours */ 
  .col-6, .col-sm-4, .col-md-3, .col-lg-2 { 
    display: flex; 
  }
  
  .book-card { 
    display: flex; 
    flex-direction: column; 
    width: 100%; 
    transition: transform 0.2s ease; 
    } 
  .book-card:hover { 
    transform: translateY(-6px) scale(1.02); 
    } 
  .book-cover { 
    position: relative; 
    overflow: hidden; 
    border-radius: 8px; 
    box-shadow: 0 4px 8px var(--shadow); 
    background: var(--border); 
    margin-bottom: 0.75rem; 
    aspect-ratio: 2 / 3; /* bring this back for uniform cover heights */ 
    } 

  .book-cover:hover { 
    box-shadow:  0 12px 20px var(--shadow); 
  }
      
  .book-cover img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; /* fills the box */ 
    object-position: center top; /* anchors to top edge */ 
    display: block; 
  } 
    
  .book-info { 
    flex: 1; /* pushes info to fill remaining card space */ 
    display: flex; 
    flex-direction: column; 
    padding: 0 0.25rem; 
  } 
  
    
  .book-title {
    color: var(--text-main);
  }

  .book-card:hover .book-title {
    color: var(--title-hover) !important;
  }

 
  .book-author {
    color: var(--text-secondary);
  }

  .book-author:hover {
    color: var(--title-hover) !important;
  }

  .book-genre { 
    margin-top: auto; 
    align-self: flex-start; 
    font-size: 0.7rem; 
    padding: 0.25rem 0.5rem; 
    background: var(--primary) !important;
    color: white;
    border-radius: 6px;
  }

  .text-muted {
    color: var(--text-main) !important;
  }

  .custom-btn {
  border-radius: 8px;
  border-color: var(--border);
  color: var(--text-main);
}

.custom-btn:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}
</style>
