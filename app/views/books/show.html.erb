<div class="container-fluid py-5">

<% if @book.present? %>

  <!-- Book title and cover -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">

      <div class="row">
        <!-- Left: Cover Image -->
        <div class="col-md-3 mb-3 mb-md-0">
          <%= image_tag @book.cover_url, 
                       alt: @book.title,
                       class: "img-fluid rounded shadow",
                       style: "max-width: 100%; height: auto;" %>
        </div>

        <!-- Right: Book Info -->
        <div class="col-md-9">
          <div class="d-flex justify-content-between flex-wrap">
            <div>
              <h1 class="fw-bold mb-2"><%= @book.title %></h1>

              <p class="text-muted mb-2">
                by <%= link_to @book.author.name,
                               author_path(@book.author),
                               class: "text-decoration-none" %>
              </p>

              <span class="badge bg-secondary mb-2">
                <%= @book.genre %>
              </span>

              <% if @average_rating %>
                
                  <div class="avg-rating">
                    <strong>Average Rating:</strong>
                    <span class="text-warning">
                      <%= '★' * @average_rating.round %>
                    </span>
                    (<%= @average_rating %>/5)
                  </div>
               
              <% end %>
            </div>

            <div class="mt-3 mt-md-0">
              <%= link_to "Back to Books",
              request.referer || books_path,
              class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>

          <hr>

          <h5 class="fw-bold">Description</h5>
          <p class="text-muted mb-0">
            <%= @book.description %>
          </p>
        </div>
      </div>

    </div>
  </div>



  <!-- favourites section -->
  <div class="mb-4">
    <% if current_user %>
      <% existing_favourite = current_user.favourites.find_by(book_id: @book.id) %>

      <% if existing_favourite %>
        <%= button_to "Remove from Favourites",
                      favourite_path(existing_favourite),
                      method: :delete,
                      class: "btn btn-danger" %>
      <% else %>
        <%= button_to "Add to Favourites",
                      favourites_path,
                      method: :post,
                      params: { favourite: { book_id: @book.id } },
                      class: "btn btn-outline-primary" %>
      <% end %>
    <% else %>
      <div class="alert alert-info">
        Login to add this book to your favourites.
      </div>
    <% end %>
  </div>



  <!-- review form -->

      <div class="review-form-container mb-5">

        <h5 class="fw-semibold mb-3">Ratings and Reviews</h4>

        <% if current_user %>
          <% if !current_user.reviews.exists?(book_id: @book.id)%>
            <%= form_with model: [@book, @review], local: true do |f| %>

              <%= f.hidden_field :book_id, value: @book.id %>

              <!--  INLINE RATING + TEXT -->
              <div class="d-flex align-items-start gap-3 flex-wrap">

                <!-- STAR RATING -->
                <div class="star-rating-input mt-1">
                  <% (1..5).each do |i| %>
                    <span class="star" data-value="<%= i %>">☆</span>
                  <% end %>
                </div>

                <!-- TEXT AREA -->
                <div class="flex-grow-1">
                  <div class="review_text">
                    <%= f.text_area :content,
                                    rows: 3,
                                    class: "form-control review-textarea",
                                    placeholder: "Write your thoughts..." %>
                  </div>
                </div>

              </div>

              <%= f.hidden_field :rating, id: "rating-input" %>

              <% if @review&.errors&.any? %>
                <div class="alert alert-danger mt-3">
                  <ul class="mb-0">
                    <% @review.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <!-- SUBMIT -->
              <div class="mt-3">
                <%= f.submit "Post Review",
                            class: "btn btn-primary px-4" %>
              </div>

            <% end %>
          <%else%>
            <div>
              <h6>You have already Reviewed this book<h6>
            </div>
          <%end%>

        <% else %>
          <div class="alert alert-info">
            Login to write a review.
          </div>
        <% end %>

      </div>
    



  <!-- reviews section -->
  <h5 class="fw-bold mb-4">
    Reviews (<%= @reviews.count %>)
  </h5>

  <% if @reviews.any? %>

    <% @vis_reviews = @reviews.order(updated_at: :desc).first(2) %>

    <% @vis_reviews.each do |review| %>

      <div class="review-item">

        <!-- Header -->
        <div class="review-header d-flex justify-content-between">
          <div>
            <strong>
              <%= link_to review.user.name,
                          user_path(review.user),
                          class: "review-user text-decoration-none" %>
            </strong>

            <span class="review-stars ms-2">
              <%= '★' * review.rating.to_i %><%= '☆' * (5 - review.rating.to_i) %>
            </span>
          </div>

          <span class="review-date">
            <%= review.updated_at.strftime('%b %d, %Y') %>
          </span>
        </div>

        <!-- Content -->
        <p class="review-content mt-2">
          <%= review.content %>
        </p>

        <!-- Actions -->
        <% if current_user && (review.user == current_user || current_user&.admin?) %>
          <div class="review-actions mt-2">

            <% if review.user == current_user %>
              <button class="btn btn-sm btn-link p-0 me-3"
                      data-bs-toggle="collapse"
                      data-bs-target="#editReview<%= review.id %>">
                Edit
              </button>
            <% end %>

            <%= button_to "Delete",
                          review_path(review),
                          method: :delete,
                          data: { confirm: "Are you sure?" },
                          class: "btn btn-sm btn-link text-danger p-0",
                          form_class: "d-inline" %>
          </div>

          <!-- Edit Form -->
          <div class="collapse mt-3" id="editReview<%= review.id %>">
            <div class="review-edit-box">

              <%= form_with model: review,
                            url: review_path(review),
                            method: :patch,
                            local: true do |f| %>

                <!-- INLINE STAR + TEXT -->
                <div class="d-flex align-items-start gap-3 flex-wrap">

                  <!-- STAR RATING -->
                  <div class="star-rating-input mt-1" data-review-id="<%= review.id %>">
                    <% (1..5).each do |i| %>
                      <span class="star <%= 'selected' if review.rating >= i %>"
                            data-value="<%= i %>">☆</span>
                    <% end %>
                  </div>

                  <!-- TEXT AREA -->
                  <div class="flex-grow-1">
                    <%= f.text_area :content,
                                    rows: 3,
                                    class: "form-control review-textarea",
                                    placeholder: "Update your review..." %>
                  </div>

                </div>

                <!-- HIDDEN RATING -->
                <%= f.hidden_field :rating,
                                  value: review.rating,
                                  id: "rating-input-#{review.id}" %>

                <!-- BUTTONS -->
                <div class="d-flex gap-2 mt-3">
                  <%= f.submit "Update", class: "btn btn-primary btn-sm" %>

                  <button type="button"
                          class="btn btn-outline-secondary btn-sm"
                          onclick="bootstrap.Collapse.getOrCreateInstance(document.getElementById('editReview<%= review.id %>')).hide()">
                    Cancel
                  </button>
                </div>

              <% end %>

            </div>
          </div>

        <% end %>

      </div>

    <% end %>

    <% if @reviews.count > 2 %>
      <div class="text-center">
        <%= link_to "See all reviews",
                    book_reviews_path(@book),
                    class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>

  <% else %>

    <div class="alert alert-info">
      No reviews yet. Be the first to review this book!
    </div>

  <% end %>

<% else %>

  <div class="alert alert-danger text-center">
    Book not found.
  </div>

<% end %>

</div>
<script>
document.addEventListener("turbo:load", () => {
  document.querySelectorAll(".star-rating-input").forEach(container => {
    const reviewId = container.dataset.reviewId;
    const stars = container.querySelectorAll(".star");
    const input = document.getElementById(`rating-input-${reviewId}`);

    if (!input) return;

    // ✅ Initialize stars based on existing value
    const initialValue = parseInt(input.value) || 0;
    stars.forEach((s, i) => {
      s.textContent = i < initialValue ? "★" : "☆";
    });

    stars.forEach((star, index) => {
      star.addEventListener("click", () => {
        const value = index + 1;
        input.value = value;

        stars.forEach((s, i) => {
          s.textContent = i < value ? "★" : "☆";
        });
      });

      // 🔥 Optional hover effect (like your main form)
      star.addEventListener("mouseover", () => {
        stars.forEach((s, i) => {
          s.textContent = i <= index ? "★" : "☆";
        });
      });

      star.addEventListener("mouseleave", () => {
        const val = parseInt(input.value) || 0;
        stars.forEach((s, i) => {
          s.textContent = i < val ? "★" : "☆";
        });
      });
    });
  });
});
</script>
<style>



.avg-rating {
  color: var(--text-main) !important;
}

.avg-rating .text-warning {
  color: #facc15 !important; 
}
  /* ===== CARD ===== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border) !important;
  box-shadow: 0 6px 16px var(--shadow) !important;
  border-radius: 12px;
}

/* ===== HEADINGS ===== */
h1, h3, h5, h6{
  color: var(--text-main);
}

/* ===== TEXT ===== */
.text-muted {
  color: var(--text-secondary) !important;
}

/* ===== AUTHOR LINK ===== */
.card a {
  color: var(--primary);
  transition: 0.2s;
}

.card a:hover {
  color: var(--primary-hover);
}

/* ===== BADGE ===== */
.badge {
  background: var(--primary) !important;
  color: white;
  border-radius: 6px;
}

/* ===== RATING STARS ===== */
.text-warning {
  color: #facc15 !important; /* keep gold */
}

/* ===== DESCRIPTION ===== */
.card p {
  line-height: 1.6;
}

/* ===== BUTTONS ===== */
.btn-outline-secondary {
  border-color: var(--border);
  color: var(--text-main);
}

.btn-outline-secondary:hover {
  background: var(--primary);
  color: white;
}

/* ===== REVIEW CARDS ===== */
.card-body {
  padding: 1.25rem;
}

/* ===== REVIEW USER NAME ===== */
.card h5 a {
  font-weight: 600;
}

/* ===== REVIEW DATE ===== */
.small.text-muted {
  font-size: 0.75rem;
}

/* ===== FORM ===== */
.form-control,
.form-select {
  background: var(--bg-main);
  border: 1px solid var(--border);
  color: var(--text-main);
}

.form-control::placeholder {
  color: var(--text-secondary);
}

/* ===== DARK MODE FIXES ===== */
[data-theme="dark"] .form-control,
[data-theme="dark"] .form-select {
  background: var(--bg-card);
}

/* ===== DETAILS BUTTON ===== */
summary.btn {
  cursor: pointer;
}

/* ===== COVER IMAGE ===== */
img.img-fluid {
  border-radius: 10px;
  box-shadow: 0 8px 18px var(--shadow);
}

/* ===== ACTION BUTTON SPACING ===== */
button, .btn {
  border-radius: 8px;
}

/* ===== COLLAPSE EDIT FORM ===== */
.card.bg-light {
  background: var(--bg-main) !important;
  border: 1px solid var(--border);
}

/* ===== REVIEW CONTAINER ===== */
.review-item {
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}

/* ===== HEADER ===== */
.review-header {
  font-size: 0.9rem;
}

/* USER */
.review-user {
  color: var(--text-main);
  font-weight: 600;
}

.review-user:hover {
  color: var(--primary);
}

/* STARS */
.review-stars {
  color: #facc15;
  font-size: 0.9rem;
}

/* DATE */
.review-date {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

/* CONTENT */
.review-content {
  font-size: 0.95rem;
  color: var(--text-main);
  line-height: 1.5;
}

/* ACTIONS */
.review-actions .btn-link {
  font-size: 0.8rem;
  color: var(--primary);
}

.review-actions .btn-link:hover {
  text-decoration: underline;
}

/* EDIT BOX */
.review-edit-box {
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 12px;
  border-radius: 8px;
}

/* REMOVE LAST BORDER */
.review-item:last-child {
  border-bottom: none;
}

/* ===== CONTAINER ===== */
.review-form-container {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px;
}

//* TEXTAREA BASE */
.review-textarea {
  background: var(--bg-main) !important;
  color: var(--text-main) !important;
  border: 1px solid var(--border) !important;
}

/* PLACEHOLDER */
.review-textarea::placeholder {
  color: var(--text-secondary) !important;
}

/* FOCUS STATE */
.review-textarea:focus {
  background: var(--bg-main) !important;
  color: var(--text-main) !important;
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 2px rgba(99,102,241,0.15);
}

/* DARK MODE EXTRA FIX */
[data-theme="dark"] .review-textarea {
  background: var(--bg-card) !important;
}

/* ===== STAR RATING ===== */
.star-rating-input {
  display: flex;
  gap: 4px;
  font-size: 1.4rem;
  cursor: pointer;
}

.star {
  color: #d1d5db;
  transition: 0.2s;
}

.star.active {
  color: #facc15;
}

/* ===== HOVER EFFECT ===== */
.star:hover {
  color: #facc15;
}
</style>