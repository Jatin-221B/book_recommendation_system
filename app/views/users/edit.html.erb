<div class="container-fluid py-5">
<h3 class="fw-bold mb-2">Edit User<h3>
<div class="card card-body bg-light">

<%= form_with model: @user, url: user_path(@user), method: :patch, local: true do |f| %>

    <div class="mb-3">
        <%= f.label :name, "Name" %>
        <%= f.text_field :name%>
    </div>
    
    <div class="mb-3">
        <%= f.label :email, "Email id:" %>
        <%= f.text_field :email%>
    </div>
    <div class="actions">
        <%= f.submit "Update" %>
    </div>
<%end%>
</div>
</div>