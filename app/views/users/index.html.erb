<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-5">
  <div>
    <h1 class="page-title">Users</h1>
    <p class="page-sub">Manage and view all registered users</p>
  </div>
  <%= link_to "Home", root_path, class: "btn users-btn-outline btn-sm mt-1" %>
</div>

<% if @users.any? %>

  <div class="row g-4">
    <% @users.each do |user| %>
      <div class="col-md-6 col-lg-4">
        <div class="user-card">

          <!-- Header -->
          <div class="user-card-header">
            <div class="user-card-avatar">
              <%= user.name.first.upcase %>
            </div>
            <div>
              <h6 class="user-card-name">
                <%= link_to user.name, user_path(user), class: "text-decoration-none" %>
              </h6>
              <% if user.admin? %>
                <span class="admin-badge">Admin</span>
              <% else %>
                <span class="member-badge">User</span>
              <% end %>
            </div>
          </div>

          <!-- Stats -->

          <div class="user-card-stats">
            <div class="stat-item">
              <span class="stat-value"><%= user.reviews.count %></span>
              <span class="stat-label">Reviews</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-value"><%= user.favourites.count %></span>
              <span class="stat-label">Favourites</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="user-card-footer">
            <%= link_to "View Profile →", user_path(user), class: "user-card-link" %>

            <% if current_user&.admin? %>
              <%= button_to "Delete",
                            user_path(user),
                            method: :delete,
                            data: { turbo_confirm: "Are you sure? This cannot be undone." },
                            class: "btn btn-outline-danger btn-sm",
                            form_class: "d-inline" %>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-5">
    <%= paginate @users %>
  </div>

<% else %>

  <div class="empty-state">
    <div class="empty-icon">👥</div>
    <h3 class="empty-title">No users yet</h3>
    <p class="empty-sub">Registered users will appear here</p>
  </div>

<% end %>

<style>

/* ===== PAGE HEADER ===== */
.page-title {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.2rem;
}

.page-sub {
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin: 0;
}

/* ===== BUTTON ===== */
.users-btn-outline {
  border: 1px solid var(--border);
  color: var(--text-main);
  background: transparent;
  border-radius: 8px;
}

.users-btn-outline:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

/* ===== USER CARD ===== */
.user-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.25rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  transition: all 0.25s ease;
  box-shadow: 0 4px 10px var(--shadow);
}

.user-card:hover {
  transform: translateY(-4px);
  border-color: var(--primary);
  box-shadow: 0 8px 20px var(--shadow);
}

/* ===== CARD HEADER ===== */
.user-card-header {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  margin-bottom: 1rem;
}

/* ===== AVATAR ===== */
.user-card-avatar {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  font-size: 1.1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== NAME ===== */
.user-card-name {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 0.2rem;
}

.user-card-name a {
  color: var(--text-main);
  transition: color 0.2s;
}

.user-card-name a:hover {
  color: var(--primary);
}

/* ===== BADGES ===== */
.admin-badge {
  font-size: 0.72rem;
  font-weight: 600;
  background: rgba(239,68,68,0.12);
  color: #ef4444;
  border: 1px solid rgba(239,68,68,0.25);
  padding: 2px 8px;
  border-radius: 20px;
}

.member-badge {
  font-size: 0.72rem;
  font-weight: 500;
  background: var(--bg-main);
  color: var(--text-secondary);
  border: 1px solid var(--border);
  padding: 2px 8px;
  border-radius: 20px;
}

/* ===== STATS ===== */
.user-card-stats {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--bg-main);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  margin-bottom: 1rem;
  flex: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-main);
}

.stat-label {
  font-size: 0.72rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.stat-divider {
  width: 1px;
  height: 28px;
  background: var(--border);
}

/* ===== CARD FOOTER ===== */
.user-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border);
  padding-top: 0.75rem;
}

.user-card-link {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--primary);
  text-decoration: none;
}

.user-card-link:hover {
  text-decoration: underline;
}

/* ===== EMPTY STATE ===== */
.empty-state {
  text-align: center;
  padding: 4rem 1rem;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 1rem;
}

.empty-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 0.5rem;
}

.empty-sub {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

</style>