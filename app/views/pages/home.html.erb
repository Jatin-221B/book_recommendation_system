<section class="bg-dark text-white text-center py-5 mb-5 rounded shadow-sm">
  <div class="container-fluid">
    <h1 class="display-4 fw-bold">Welcome to BookNest</h1>
    <p class="lead mt-3">
      Discover books, read reviews, and share your thoughts
    </p>
  </div>
</section>

<!-- recent books-->
<section class="mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Recently Added Books</h2>
    <%= link_to "View All", books_path, class: "btn btn-sm btn-outline-primary" %>
  </div>

  <% if @recent_books.any? %>
    <div class="row g-4 books-grid">
      <% @recent_books.each do |book| %>
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
          <%= link_to book_path(book), class: "text-decoration-none w-100" do %>
            <div class="book-card-home">
              
              <!-- Cover Image -->
              <div class="book-cover-home">
                <%= image_tag book.cover_url, 
                             alt: book.title %>
              </div>
              
              <!-- Book Info -->
              <div class="book-info-home mt-2">
                <h6 class="book-title-home">
                  <%= truncate(book.title, length: 50) %>
                </h6>
                
                <p class="book-author-home mb-1">
                  <%= truncate(book.author.name, length: 35) %>
                </p>
                
                <span class="badge bg-secondary badge-sm">
                  <%= book.genre %>
                </span>
              </div>
              
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      No books yet. Check back soon!
    </div>
  <% end %>
</section>

<!-- explore section -->
<section class="bg-light p-4 rounded shadow-sm">
  <h2 class="fw-bold mb-3">Explore</h2>

  <div class="row g-3">
    <div class="col-md-6 d-flex">
      <div class="card border-0 shadow-sm w-100">
        <div class="card-body">
          <h5 class="card-title">Browse All Books</h5>
          <p class="card-text text-muted">
            Discover our full collection of books across genres.
          </p>
          <%= link_to "Browse Books", books_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="col-md-6 d-flex">
      <div class="card border-0 shadow-sm w-100">
        <div class="card-body">
          <h5 class="card-title">Browse Authors</h5>
          <p class="card-text text-muted">
            Explore authors and learn more about their works.
          </p>
          <%= link_to "Browse Authors", authors_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* Books grid columns only */
.books-grid > [class*="col-"] {
  display: flex;
}

.book-card-home {
  display: flex;
  flex-direction: column;
  width: 100%;
  transition: transform 0.2s ease;
}

.book-card-home:hover {
  transform: translateY(-5px);
}

.book-cover-home {
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  background: #f8f9fa;
  aspect-ratio: 2 / 3;
  margin-bottom: 0.5rem;
}

.book-cover-home:hover {
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}

.book-cover-home img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.book-info-home {
  flex: 1;
  display: flex;
  flex-direction: column;
  text-align: left;
}

.book-title-home {
  color: #212529;
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
  line-height: 1.3;
  min-height: 2.4rem;
}

.book-author-home {
  color: #6c757d;
  font-size: 0.8rem;
  margin-bottom: 0.25rem;
}

.badge-sm {
  margin-top: auto;
  align-self: flex-start;
  font-size: 0.7rem;
  padding: 0.25rem 0.5rem;
}

@media (max-width: 576px) {
  .book-title-home {
    font-size: 0.85rem;
    min-height: 2.2rem;
  }

  .book-author-home {
    font-size: 0.75rem;
  }
}
</style>