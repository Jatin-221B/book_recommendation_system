<!DOCTYPE html>
<html>
  <head>
    <title>BookNest</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
      :root {
        --bg-main: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #111827;
        --text-secondary: #6b7280;
        --primary: #6366f1;
        --primary-hover: #4f46e5;
        --border: #e5e7eb;
        --shadow: rgba(0,0,0,0.05);
      }

      * {
        font-family: 'Inter', sans-serif;
      }

      body {
        background: var(--bg-main);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* ===== AUTH CARD ===== */
      .auth-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 2rem;
        box-shadow: 0 8px 24px var(--shadow);
      }

      /* ===== BRAND ===== */
      .auth-brand {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--primary);
        text-decoration: none;
      }

      .auth-brand:hover {
        color: var(--primary-hover);
      }

      .auth-tagline {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
      }

      /* ===== FORM INPUTS ===== */
      .form-control {
        background: var(--bg-main);
        border: 1px solid var(--border);
        color: var(--text-main);
        border-radius: 8px;
        padding: 0.6rem 0.9rem;
        font-size: 0.9rem;
      }

      .form-control:focus {
        background: var(--bg-main);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
        color: var(--text-main);
      }

      .form-control::placeholder {
        color: var(--text-secondary);
      }

      .form-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-main);
        margin-bottom: 0.4rem;
      }

      /* ===== BUTTON ===== */
      .btn-auth {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.65rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        width: 100%;
        transition: background 0.2s;
      }

      .btn-auth:hover {
        background: var(--primary-hover);
        color: white;
      }

      /* ===== LINKS ===== */
      .auth-link {
        color: var(--primary);
        font-size: 0.85rem;
        text-decoration: none;
      }

      .auth-link:hover {
        text-decoration: underline;
        color: var(--primary-hover);
      }

      .auth-divider {
        font-size: 0.8rem;
        color: var(--text-secondary);
        text-align: center;
        margin: 1rem 0;
      }

      /* ===== CHECKBOX ===== */
      .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
      }

      .form-check-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
      }

      /* ===== ERROR ===== */
      .alert {
        border-radius: 10px;
        font-size: 0.85rem;
      }
    </style>
  </head>

  <body>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

          <!-- Brand -->
          <div class="text-center mb-4">
            <%= link_to " BookNest", root_path, class: "auth-brand" %>
            <p class="auth-tagline">Your personal book discovery platform</p>
          </div>

          <!-- Card -->
          <div class="auth-card">
            <%= yield %>
          </div>

          <!-- Footer -->
          <p class="text-center mt-4" style="font-size: 0.8rem; color: var(--text-secondary);">
            BookNest © <%= Time.current.year %>
          </p>

        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>