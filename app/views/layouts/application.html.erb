<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BookNest" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        margin: 0;
      }

      /* NAVBAR */
      .navbar {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        padding: 0.7rem 1.5rem;
      }

      .navbar-brand {
        font-weight: 600;
        color: #6366f1 !important;
        font-size: 1.4rem;
      }

      .nav-link {
        color: #374151 !important;
        font-weight: 500;
        transition: 0.2s;
      }

      .nav-link:hover {
        color: #6366f1 !important;
      }

      /* SEARCH */
      .search-box input {
        border-radius: 8px 0 0 8px;
        border: 1px solid #e5e7eb;
      }

      .search-box button {
        background: #6366f1;
        color: white;
        border: none;
        border-radius: 0 8px 8px 0;
      }

      .search-box button:hover {
        background: #4f46e5;
      }

      /* MAIN CONTENT FULL WIDTH */
      main {
        width: 100%;
        padding: 20px 30px;
      }

      .content-wrapper {
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.05);
      }

      /* FLASH */
      .alert {
        border-radius: 10px;
        margin: 10px 20px;
      }

      /* BUTTONS */
      .btn-success {
        background: #10b981;
        border: none;
      }

      .btn-success:hover {
        background: #059669;
      }

      .btn-outline-light {
        border-color: #6366f1;
        color: #6366f1;
      }

      .btn-outline-light:hover {
        background: #6366f1;
        color: white;
      }

      /* DROPDOWN */
      .dropdown-menu {
        border-radius: 10px;
        border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      }

      /* FOOTER */
      footer {
        background: #ffffff;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
      }

      /* RESPONSIVE */
      @media (max-width: 768px) {
        main {
          padding: 15px;
        }

        .search-box {
          width: 100%;
          margin-top: 10px;
        }
      }
    </style>
  </head>

  <body class="d-flex flex-column min-vh-100">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <%= link_to "BookNest", root_path, class: "navbar-brand" %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">

        <!-- LEFT -->
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <%= link_to "Books", books_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Authors", authors_path, class: "nav-link" %>
          </li>
          <% if current_user&.admin? %>
            <li class="nav-item">
              <%= link_to "Users", users_path, class: "nav-link" %>
            </li>
          <% end %>
        </ul>

        <!-- SEARCH -->
        <%= form_with url: search_books_path, method: :get, local: true,
              class: "d-flex me-3 search-box", style: "max-width: 400px;" do |f| %>
          <div class="input-group">
            <%= f.text_field :q, value: params[:q],
                  placeholder: "Search books or authors...",
                  class: "form-control" %>
            <button class="btn">🔍</button>
          </div>
        <% end %>

        <!-- RIGHT -->
        <ul class="navbar-nav">
          <% if user_signed_in? %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                <%= current_user.name %>
                <% if current_user.admin? %>
                  <span class="badge bg-danger ms-1">ADMIN</span>
                <% end %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li>
                  <%= link_to "My Profile", user_path(current_user), class: "dropdown-item" %>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to "Sign Out",
                        destroy_user_session_path,
                        method: :delete,
                        class: "dropdown-item text-danger",
                        form: { style: "display:inline;" },
                        data: { turbo: false } %>
                </li>
              </ul>
            </li>
          <% else %>
            <li class="nav-item me-2">
              <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-light btn-sm" %>
            </li>
            <li class="nav-item">
              <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-success btn-sm" %>
            </li>
          <% end %>
        </ul>

      </div>
    </div>
  </nav>

  <!-- FLASH -->
  <% flash.each do |type, message| %>
    <div class="alert <%= type == "notice" ? "alert-success" : "alert-danger" %> alert-dismissible fade show">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <!-- MAIN -->
  <main class="flex-grow-1">
    <div class="content-wrapper">
      <%= yield %>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="text-center py-3 mt-auto">
    <small>BookNest © <%= Time.current.year %></small>
  </footer>

  <!-- Bootstrap -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>